@model CFP.Web.Areas.Medicare.Models.ApplicationViewModel


<div class="modal-header">
    <h4 class="modal-title fw-600">
        <i class="ri-user-3-line font-20"></i> Update Application Status
    </h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="card mb-0">
    <div class="card-body" style="padding-left:1rem;padding-right:1rem;">
        <form class="form-horizontal form-material mb-0 " id="updateStatusForm">

            <input hidden asp-for="MedicareJobModel.Status" />
            <input hidden asp-for="MedicareJobModel.EncJobApplicationId" />
            <div class="col-md-12 mt-2">
                <h5>
                    Status:
                    @if (Model.MedicareJobModel.Status == 2)
                    {
                        <span class="badge bg-success font-14">Approved</span>
                    }
                    else if (Model.MedicareJobModel.Status == 3)
                    {
                        <span class="badge bg-danger font-14">Rejected</span>
                    }
                    else
                    {
                        <span class="badge bg-warning font-14">Pending</span>
                    }
                </h5>
            </div>

                <div class="col-md-12 mt-2">
                    <label asp-for="MedicareJobModel.Comment">Comment</label>
                    <textarea asp-for="MedicareJobModel.Comment" rows="3" class="form-control req-border" placeholder="Comment" id="statusComment"></textarea>
                </div>
            </form>
        </div>
    </div>

    <div class="modal-footer mt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="ri-close-line"></i> Close
        </button>
        <button type="button" class="btn btn-success" onclick="CFP.Medicare.Application.SaveApplicationStatus()"><i class="ri-save-line"></i> Submit</button>

    </div>
