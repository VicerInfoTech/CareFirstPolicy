@model DashboardViewModel

<style>
    #common-lg-dialogApp .modal-dialog {
        width: 100vw !important;
        max-width: 100vw !important;
        height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    #common-lg-dialogApp .modal-content {
        height: 100vh !important;
        border-radius: 0 !important;
    }

    .app-cards-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
    }

    .app-card {
        width: calc((100% / 3) - 1rem); /* 3 cards per row */
        max-width: 200px;
        height: 180px;
        border-radius: 15px;
        background: #ffffff;
        padding: 15px;
        cursor: pointer;
        box-shadow: 0px 0px 12px rgba(0,0,0,0.2);
        transition: 0.2s;
        text-align: center;
    }

        .app-card:hover {
            transform: scale(1.08);
        }

    .app-logo {
        width: 75px;
        height: 75px;
        object-fit: contain;
        margin-bottom: 5px;
    }

    @@media (max-width: 768px) {
        .app-card

    {
        width: calc((100% / 2) - 1rem); /* 2 cards per row on tablets */
    }

    }

    @@media (max-width: 480px) {
        .app-card

    {
        width: 100%; /* 1 card per row on mobile */
    }

    }
</style>

<div class="modal-header">
    <h4 class="modal-title fw-600" id="myModalLabel">
        <i class="ri-apps-line font-20"></i> Select Your App
    </h4>
</div>

<div class="card" style="margin-bottom:0px !important">
    <div class="card-body" style="padding-left:1rem;padding-right:1rem;">
        <div class="app-cards-container">
            @foreach (var app in Model.AgentAppList)
            {
                <div class="app-card" onclick="CFP.Dashboard.SelectApp(@app.AppId)">
                    <img src="/lib/images/@app.LogoName" class="app-logo" />
                    <h3>@app.AppName</h3>
                </div>
            }
        </div>
    </div>
</div>
