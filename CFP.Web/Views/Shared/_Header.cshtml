@using CFP.Common.Utility
@inject CFP.Common.Utility.ISessionManager SessionData

<header id="page-topbar">
	<div class="layout-width">
		<div class="navbar-header d-flex justify-content-between align-items-center w-100">
			<div class="d-flex">
				<!-- LOGO -->
				<div class="navbar-brand-box horizontal-logo">
					<a asp-action="Index" asp-controller="Dashboard" class="logo logo-dark" style="margin:10px;">
						<span class="logo-sm">
							<img src="~/assets/images/logo-sm.png" alt="" height="22">
						</span>
						<span class="logo-lg">
							<h1 style="font-weight:900">CFP</h1>
						</span>
					</a>
					<!-- Light Logo-->
					<a asp-action="Index" asp-controller="Dashboard" class="logo logo-light" style="margin:10px;">
						<span class="logo-sm">
							<img src="~/assets/images/logo-sm.png" alt="" height="22">
						</span>
						<span class="logo-lg">
							<h1 class="text-white" style="font-weight:900">CFP</h1>
						</span>
					</a>
				</div>

				<button type="button" class="btn btn-sm px-3 fs-16 vertical-menu-btn topnav-hamburger" id="topnav-hamburger-icon">
					<span class="hamburger-icon">
						<span></span>
						<span></span>
						<span></span>
					</span>
				</button>
			</div>

			<div class="d-flex align-items-center gap-3">

				@if (SessionData.RoleId == (int)Enumeration.Role.Super_Admin)   // 1 = Admin
				{
					<div style="display:none">
						<a asp-controller="AiAssistant" asp-action="Index"
						   class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle">
							<i class="ri-robot-2-line fs-22"></i>
						</a>
					</div>
				}

				<div id="notificationArea">
					@await Component.InvokeAsync("Notification")
				</div>

				<div>
					@await Component.InvokeAsync("UserNameHeader")
				</div>

			</div>
		</div>
	</div>
</header>

