@using CFP.Common.Utility

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    @await Html.PartialAsync("_HeaderScriptPartial")

    <title>@AppCommon.ApplicationTitle - @ViewData["Title"]</title>

    @RenderSection("CSS", required: false)
    @RenderSection("Style", required: false)

    <style>
        body {
            background: #f8f9fa;
        }

        .public-header {
            background: #fff;
            border-bottom: 1px solid #e6e6e6;
            padding: 15px 20px;
        }

        .public-logo h1 {
            margin: 0;
            font-weight: 900;
            font-size: 26px;
            color: #333;
        }

        .public-container {
            padding: 30px 20px 50px 20px;
            /* Removed container width restrictions */
        }

        footer.footer {
            width: 100%;
            background: #fff;
            border-top: 1px solid #e6e6e6;
            padding: 10px 0;
            text-align: center;
            margin: 0;
            left: 0 !important;
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <header class="public-header d-flex align-items-center">
        <div class="public-logo">
            <h1>CFP</h1>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="public-container">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    
    <footer class="footer d-flex align-items-center">
        <div class="public-logo">
            @AppCommon.CurrentDate.Year © @AppCommon.ApplicationTitle
        </div>
    </footer>
    @await Html.PartialAsync("_FooterScriptPartial")
    @RenderSection("scripts", required: false)

</body>
</html>
