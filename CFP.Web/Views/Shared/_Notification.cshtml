@model DashboardViewModel

<div class="dropdown topbar-head-dropdown ms-1 header-item" id="notificationDropdown">
	<button type="button"
			class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle"
			id="page-header-notifications-dropdown"
			data-bs-toggle="dropdown"
			data-bs-auto-close="outside">
		<i class="bx bx-bell fs-22"></i>

		@if (Model.NotificationList.Count > 0)
		{
			<span id="notifCount"
				  class="position-absolute topbar-badge fs-10 translate-middle badge rounded-pill bg-danger">
				@Model.NotificationList.Count
			</span>
		}
	</button>

	<div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0">
		<div class="dropdown-head bg-secondary bg-pattern rounded-top">
			<div class="p-3">
				<h6 class="m-0 fs-16 fw-semibold text-white">Notifications</h6>
			</div>
		</div>

		<div style="max-height:300px" data-simplebar>
			<div id="notifItems">
				@foreach (var item in Model.NotificationList)
				{
					<a asp-controller="Chat" asp-action="Index" asp-route-openUserId="@item.SenderUserId"
					   asp-route-openRoomId="@item.RoomId">
						
						<div class="text-reset notification-item d-block dropdown-item">
							<div class="d-flex">
								<img src="@item.ProfilePic" class="me-3 rounded-circle avatar-xs" />
								<div class="flex-grow-1">
									<h6 class="mt-0 mb-1 fs-13 fw-semibold">@item.SenderName</h6>
									<p class="text-muted mb-1">@item.Message</p>
									<p class="mb-0 fs-11 fw-medium text-uppercase text-muted">
										<i class="mdi mdi-clock-outline"></i> @item.TimeAgo
									</p>
								</div>
							</div>
						</div>
							</a>
				}

				@if (Model.NotificationList.Count == -0)
				{
					<div class="text-reset notification-item d-block dropdown-item">
						<div class="d-flex">

							<div class="flex-grow-1">
								<h6 class="mt-0 mb-1 fs-13 fw-semibold">No data available</h6>

							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>
