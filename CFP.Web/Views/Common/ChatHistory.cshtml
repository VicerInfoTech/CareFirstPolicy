@model DashboardViewModel
@{
    ViewData["Title"] = "Deal";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //ViewBag.ParentPageName = "Deal";
    ViewBag.ParentPageName = "<a href='/Dashboard/Index'><i class='ri-home-2-line'></i> Home</a>";
    ViewBag.PageName = "<i class='ri-chat-history-line'></i>  Chat History";
}
<link href="~/lib/css/gorev/bootstrap-datepicker.min.css" rel="stylesheet" asp-append-version="true" />
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                @Html.Hidden("StartDate", Model.StartDate.ToString("MM/dd/yyyy"), new { id = "startDate" })
                @Html.Hidden("EndDate", Model.EndDate.ToString("MM/dd/yyyy"), new { id = "endDate" })

                <div class="row">
                    <div class=" col-sm-2" id="divSearch">
                        <div class="input-group mt-1">
                            <div class="input-group-append pointermouse" onclick="CFP.Common.ChatSearch()">
                                <span class="input-group-text"><i class="ri-search-line"></i></span>
                            </div>
                            <input class="form-control" id="txtSearch" autocomplete="off" placeholder="Search..." />

                        </div>
                    </div>

                    <div class="col-sm-2" id="divChatType">
                        <div class="input-group mt-1">
                            <span class="input-group-text"><i class="ri-chat-1-line"></i></span>
                            <select class="form-select" id="chatTypeId" onchange="ToggleFilters()">
                                <option value="1">Private</option>
                                <option value="2">Channel</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-sm-2" id="divFromUser">
                        <div class="input-group mt-1">
                            <span class="input-group-text">Sender</span>
                            <select asp-items="Model.AgentList" class="form-select" id="fromUserId" onchange="CFP.Common.ChatSearch()">
                                <option value="-1">All</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-sm-2" id="divToUser">
                        <div class="input-group mt-1">
                            <span class="input-group-text">Receiver</span>
                            <select asp-items="Model.AgentList" class="form-select" id="toUserid" onchange="CFP.Common.ChatSearch()">
                                <option value="-1">All</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-sm-2 d-none" id="divRoomId">
                        <div class="input-group mt-1">
                            <span class="input-group-text">Channel</span>
                            <select asp-items="Model.RoomList" class="form-select" id="roomid" onchange="CFP.Common.ChatSearch()">
                                <option value="-1">All</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-sm-2" id="divSendDate">
                        <div class="input-group mt-1">
                            <span class="input-group-text">
                                <i class="ri-calendar-line"></i>
                            </span>
                            <input type="text"
                                   id="dateRange"
                                   class="form-control date-picker"
                                   placeholder="Select date range"
                                   data-provider="flatpickr"
                                   data-mode="range"
                                   data-date-format="m/d/Y"
                                   autocomplete="off" />

                        </div>
                    </div>

                    <div class="col-sm-2 d-none" id="divMsgType">
                        <div class="input-group mt-1">
                            <span class="input-group-text">
                                <i class="ri-message-2-line"></i>
                            </span>
                            <select class="form-select" id="msgTypeId" onchange="CFP.Common.ChatSearch()">
                                <option value="-1">All</option>
                                <option value="1">Text</option>
                                <option value="2">Media</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-sm-2 mt-1" >
                        <button type="button" class="btn btn-success" onclick="CFP.Common.DownloadChatHistData()">
                            <i class="ri-download-line"></i> Download
                        </button>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 table-responsive">
                        <table class="table table-hover table-bordered display responsive wrap" width="100%" id="chatHistoryTableId">
                            <thead>
                                <tr>
                                    <th class="col-2">  <b>Send Time</b></th>
                                    <th class="col-2"><b>Sender Name</b></th>
                                    <th class="col-2"><b>Receiver Name</b></th>
                                    <th class="col-5"><b>Message</b></th>
                                    <th class="col-1"><b>Message Type</b></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/js/gorev/bootstrap-datepicker.min.js" asp-append-version="true"></script>
    <script src="~/lib/js/custom/CFP.Common.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            CFP.Common.ChatHistory();
            $("#txtSearch").on("keyup", function () {
                CFP.Common.ChatSearch();
            });

              // Flatpickr range picker
              var startDate = $("#startDate").val();
        var endDate = $("#endDate").val();

        $("#dateRange").flatpickr({
            mode: "range",
            dateFormat: "m/d/Y", // UI format
            defaultDate: [startDate, endDate],
            onChange: function (selectedDates, dateStr, instance) {
                if (selectedDates.length === 2) {
                    $("#startDate").val(instance.formatDate(selectedDates[0], "m/d/Y"));
                    $("#endDate").val(instance.formatDate(selectedDates[1], "m/d/Y"));
                   CFP.Common.ChatSearch();
                }
            }
        });

        });


                      function ToggleFilters() {

            let chatType = $("#chatTypeId").val(); // 1 = Private, 2 = Room

             if (chatType === "1") {
            // PRIVATE CHAT
            $("#divToUser").removeClass("d-none");

            $("#divRoomId").addClass("d-none");
            $("#divMsgType").addClass("d-none");
        } else {
            // CHANNEL / ROOM CHAT
            $("#divToUser").addClass("d-none");

            $("#divRoomId").removeClass("d-none");
            $("#divMsgType").removeClass("d-none");
        }


            // reload table
            CFP.Common.ChatSearch();
        }

    </script>
}
