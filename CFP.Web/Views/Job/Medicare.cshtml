@section Scripts {
    <script>

         $(document).ready(function () {
              $.validator.unobtrusive.parse($("#jobForm"));
               CFP.Common.InitDatePicker();
               CFP.Common.InitMask();
                  $('#multipleSelect').select2();
         });


        let currentStep = 1;
        const totalSteps = 4;

                        function updateSteps() {
                                  const stepTitles = ["Create Profile", "Welcome", "About Us", "Bank Details"];
        document.getElementById("stepTitle").innerText = stepTitles[currentStep - 1];
            // Hide all steps
            document.querySelectorAll('.step').forEach(x => x.classList.add('d-none'));

            // Show current step section
            document.getElementById(`step${currentStep}`).classList.remove('d-none');

            // Update circle buttons
            for (let i = 1; i <= totalSteps; i++) {
                let btn = document.getElementById(`stepBtn${i}`);

                if (i < currentStep) {
                    btn.classList.remove("btn-light");
                    btn.classList.add("btn-success"); // completed
                }
                else if (i === currentStep) {
                    btn.classList.remove("btn-light");
                    btn.classList.add("btn-success"); // current
                }
                else {
                    btn.classList.remove("btn-success");
                    btn.classList.add("btn-light"); // upcoming
                }
            }

            // Update progress line
            let percent = ((currentStep - 1) / (totalSteps - 1)) * 100;
            document.getElementById("progressLine").style.width = percent + "%";
        }



        // Next
        document.querySelectorAll('.next-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                 if ($("#jobForm").valid()) {
                if (currentStep < totalSteps) {
                    currentStep++;
                    updateSteps();
                }
                }
            });
        });

        // Previous
        document.querySelectorAll('.prev-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                if (currentStep > 1) {
                    currentStep--;
                    updateSteps();
                }
            });
        });

        updateSteps();
                function calculateFormCompletion() {
            const fields = document.querySelectorAll('.track-field');
            const totalFields = fields.length;
            let filled = 0;

            fields.forEach(field => {
                if (field.value.trim() !== "") {
                    filled++;
                }
            });

            let percent = Math.round((filled / totalFields) * 100);

            // Update the new independent progress bar
            const bar = document.getElementById("completionProgress");
            bar.style.width = percent + "%";
            bar.setAttribute("aria-valuenow", percent);
            bar.innerText = percent + "%";
        }

        // Recalculate on every input/change
        document.addEventListener("input", function (e) {
            if (e.target.classList.contains("track-field")) {
                calculateFormCompletion();
            }
        });
    </script>
}
