@using CFP.Common.Utility
@model DashboardViewModel
@{
    ViewData["Title"] = "Job Application";
    Layout = "~/Views/Shared/_JobLayout.cshtml";

}
<style>
    .start-33 {
        left: 33%;
    }

    .start-66 {
        left: 66%;
    }

    .page-content {
        margin-top: 100px !important;
        padding: 0px !important;
    }
   
    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background-color: #6691e7;
    }
</style>
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Job Application for Medicare</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Job</a></li>
                    <li class="breadcrumb-item active">Medicare</li>
                </ol>
            </div>

        </div>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">Application for Insurance Agent Position (Medicare Specialist)</h4>
            </div>
            <div class="card-body">
                <form class="form-horizontal form-material mb-0  " id="jobForm">
                    <div class="text-center pt-3 pb-4 mb-1">
                        <h5 id="stepTitle">Profile</h5>
                    </div>

                    <div class="position-relative m-4" id="stepProgress">
                        <div class="progress" style="height: 2px;">
                            <div id="progressLine" class="progress-bar" role="progressbar"
                                 style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <!-- Step 1 - 0% -->
                        <button type="button" id="stepBtn1"
                                class="position-absolute top-0 start-0 translate-middle btn btn-sm btn-primary rounded-pill"
                                style="width: 2rem; height: 2rem;">
                            1
                        </button>

                        <!-- Step 2 - 33% -->
                        <button type="button" id="stepBtn2"
                                class="position-absolute top-0 start-33 translate-middle btn btn-sm btn-light rounded-pill"
                                style="width: 2rem; height: 2rem;">
                            2
                        </button>

                        <!-- Step 3 - 66% -->
                        <button type="button" id="stepBtn3"
                                class="position-absolute top-0 start-66 translate-middle btn btn-sm btn-light rounded-pill"
                                style="width: 2rem; height: 2rem;">
                            3
                        </button>

                        <!-- Step 4 - 100% -->
                        <button type="button" id="stepBtn4"
                                class="position-absolute top-0 start-100 translate-middle btn btn-sm btn-light rounded-pill"
                                style="width: 2rem; height: 2rem;">
                            4
                        </button>
                    </div>

                    <div style=" margin-top: 3.5rem !important;">
                        <!-- STEP 1 -->
                        <div class="step" id="step1">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label>First Name <span style="color:red;">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-user-line"></i></span>
                                        <input asp-for="MedicareJobModel.FirstName" type="text" class="form-control" />
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.FirstName" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label>Last Name <span style="color:red;">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-user-line"></i></span>
                                        <input asp-for="MedicareJobModel.LastName" type="text" class="form-control" />
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.LastName" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label>Date of Birth <span style="color:red;">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-calendar-line"></i></span>
                                        <input asp-for="MedicareJobModel.Dob" class="form-control date-picker" />
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.Dob" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label>Address 1 <span style="color:red;">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-map-pin-line"></i></span>
                                        <input asp-for="MedicareJobModel.Address1" type="text" class="form-control" />
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.Address1" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label>Address 2</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-map-pin-line"></i></span>
                                        <input asp-for="MedicareJobModel.Address2" type="text" class="form-control" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label>City <span style="color:red;">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-building-line"></i></span>
                                        <input asp-for="MedicareJobModel.City" type="text" class="form-control" />
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.City" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label>State <span style="color:red;">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-map-line"></i></span>
                                        <select asp-for="MedicareJobModel.StateId" class="form-select" asp-items="Model.StateList"></select>
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.StateId" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label>Zip <span style="color:red;">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-pin-distance-line"></i></span>
                                        <input asp-for="MedicareJobModel.ZipCode" type="text" class="form-control zipcode-inputmask" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label>NPN <span style="color:red;">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-passport-line"></i></span>
                                        <input asp-for="MedicareJobModel.Npn" type="text" class="form-control" />
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.Npn" class="text-danger"></span>
                                </div>


                                <div class="col-md-4">
                                    <label>Email</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-mail-line"></i></span>
                                        <input asp-for="MedicareJobModel.Email" class="form-control email-inputmask " />
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.Email" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label>Phone <span style="color:red;">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-phone-line"></i></span>
                                        <input asp-for="MedicareJobModel.PhoneNo" type="text" class="form-control phone-inputmask" />
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.PhoneNo" class="text-danger"></span>
                                </div>

                            </div>

                            <div class="text-end mt-3">
                                <button type="button" class="btn btn-success btn-label right ms-auto   next-btn"><i class="ri-arrow-right-line label-icon align-middle fs-16 ms-2"></i>Next</button>
                            </div>
                        </div>

                        <!-- STEP 2 -->
                        <div class="step d-none" id="step2">

                            <div class="row g-3">

                                <!-- About You -->
                                <div class="col-md-12">
                                    <label>About You</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-edit-line"></i></span>
                                        <textarea asp-for="MedicareJobModel.AboutAgent" class="form-control"></textarea>
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.AboutAgent" class="text-danger"></span>
                                </div>

                                <!-- State License (multi-select) -->
                                <div class="col-md-4">
                                    <label>State License</label>
                                    <span style="color:red;">*</span>
                                    <select asp-for="MedicareJobModel.StateLicenceList"
                                            class="form-select"
                                            id="multipleSelect"
                                            multiple
                                            data-placeholder="Select"
                                            asp-items="Model.StateList">
                                    </select>
                                    @*   <div class="input-group">
                                        <span class="input-group-text"><i class="ri-folder-2-line"></i></span>
                                       
                                    </div> *@
                                    <span asp-validation-for="MedicareJobModel.StateLicenceList" class="text-danger"></span>
                                </div>

                                <!-- State License Number -->
                                <div class="col-md-4">
                                    <label>State License No.</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-numbers-line"></i></span>
                                        <input asp-for="MedicareJobModel.StateLicenceNo" type="text" class="form-control" />
                                        <span asp-validation-for="MedicareJobModel.StateLicenceNo" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- State License Doc -->
                                <div class="col-md-4">
                                    <label>State License Doc</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-file-upload-line"></i></span>
                                        <input type="file"
                                               id="JobDoc_2"
                                               class="form-control"
                                               onchange="CFP.Dashboard.SaveDocument(@((int)Enumeration.MedicareJobDoc.StateLicenceDoc))" />
                                    </div>
                                </div>

                                <!-- Years of Experience -->
                                <div class="col-md-4">
                                    <label>Years of Experience</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-timer-line"></i></span>
                                        <input asp-for="MedicareJobModel.Yoe" type="number" class="form-control" min="0" />
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.Yoe" class="text-danger"></span>
                                </div>

                                <!-- Carrier -->
                                <div class="col-md-4">
                                    <label>Carrier</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-building-line"></i></span>
                                        <select asp-for="MedicareJobModel.Carrier" class="form-select" asp-items="Model.CareerList"></select>
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.Carrier" class="text-danger"></span>
                                </div>

                                <!-- AHIP -->
                                <div class="col-md-4">
                                    <label>AHIP</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-graduation-cap-line"></i></span>
                                        <select asp-for="MedicareJobModel.Ahip" class="form-select">
                                            <option value="true">Yes</option>
                                            <option value="false">No</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.Ahip" class="text-danger"></span>
                                </div>

                            </div>


                            <div class="d-flex justify-content-between mt-3">
                                <button type="button" class="btn btn-link text-decoration-none btn-label prev-btn"><i class="ri-arrow-left-line label-icon align-middle fs-16 me-2"></i> Back </button>

                                <button type="button" class="btn btn-success btn-label right ms-auto   next-btn"><i class="ri-arrow-right-line label-icon align-middle fs-16 ms-2"></i>Next</button>

                            </div>
                        </div>

                        <!-- STEP 3 -->
                        <div class="step d-none" id="step3">

                            <div class="mb-3">
                                <label>About Us</label>
                                <div>
                                    We are @AppCommon.ApplicationTitle.
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mt-3">
                                <button type="button" class="btn btn-link text-decoration-none btn-label prev-btn"><i class="ri-arrow-left-line label-icon align-middle fs-16 me-2"></i> Back </button>

                                <button type="button" class="btn btn-success btn-label right ms-auto   next-btn"><i class="ri-arrow-right-line label-icon align-middle fs-16 ms-2"></i>Next</button>

                            </div>
                        </div>

                        <!-- STEP 4 -->
                        <div class="step d-none" id="step4">

                            <div class="row g-3">

                                <!-- Bank Name -->
                                <div class="col-md-4">
                                    <label>Bank Name</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-bank-line"></i></span>
                                        <input asp-for="MedicareJobModel.BankName" type="text" class="form-control" />
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.BankName" class="text-danger"></span>
                                </div>

                                <!-- Account Holder Name -->
                                <div class="col-md-4">
                                    <label>Account Holder Name</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-user-3-line"></i></span>
                                        <input asp-for="MedicareJobModel.AccHolderName" type="text" class="form-control" />
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.AccHolderName" class="text-danger"></span>
                                </div>

                                <!-- Account Number -->
                                <div class="col-md-4">
                                    <label>Account Number</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-numbers-line"></i></span>
                                        <input asp-for="MedicareJobModel.BankAccNo" type="text" class="form-control" />
                                    </div>
                                    <span asp-validation-for="MedicareJobModel.BankAccNo" class="text-danger"></span>
                                </div>

                                <!-- Profile Photo -->
                                <div class="col-md-4">
                                    <label>Profile Picture</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-camera-line"></i></span>
                                        <input type="file" id="JobDoc_1" class="form-control"
                                               onchange="CFP.Dashboard.SaveDocument(@((int)Enumeration.MedicareJobDoc.ProfileDoc))" />
                                    </div>
                                </div>

                                <!-- Assignment of Commission -->
                                <div class="col-md-4">
                                    <label>Assignment of Commission</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-file-list-3-line"></i></span>
                                        <input type="file" id="JobDoc_3" class="form-control"
                                               onchange="CFP.Dashboard.SaveDocument(@((int)Enumeration.MedicareJobDoc.AssignentCommissionDoc))" />
                                    </div>
                                </div>

                                <!-- ENO Certificate -->
                                <div class="col-md-4">
                                    <label>ENO Certificate</label>
                                    <span style="color:red;">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="ri-file-paper-line"></i></span>
                                        <input type="file" id="JobDoc_4" class="form-control"
                                               onchange="CFP.Dashboard.SaveDocument(@((int)Enumeration.MedicareJobDoc.EnoCertificateDoc))" />
                                    </div>
                                </div>
                            </div>


                            <div class="d-flex justify-content-between mt-3">
                                <button type="button" class="btn btn-link text-decoration-none btn-label prev-btn"><i class="ri-arrow-left-line label-icon align-middle fs-16 me-2"></i> Back </button>
                                <button type="button" class="btn btn-success btn-label right ms-auto " onclick="CFP.Dashboard.SaveJobForm()"><i class="ri-arrow-right-line label-icon align-middle fs-16 ms-2"></i>Submit</button>
                            </div>
                        </div>

                    </div>


                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>

         $(document).ready(function () {
              $.validator.unobtrusive.parse($("#jobForm"));
               CFP.Common.InitDatePicker();
               CFP.Common.InitMask();
                  $('#multipleSelect').select2();
         });


        let currentStep = 1;
        const totalSteps = 4;

                        function updateSteps() {
                                  const stepTitles = ["Create Profile", "Welcome", "About Us", "Bank Details"];
        document.getElementById("stepTitle").innerText = stepTitles[currentStep - 1];
            // Hide all steps
            document.querySelectorAll('.step').forEach(x => x.classList.add('d-none'));

            // Show current step section
            document.getElementById(`step${currentStep}`).classList.remove('d-none');

            // Update circle buttons
            for (let i = 1; i <= totalSteps; i++) {
                let btn = document.getElementById(`stepBtn${i}`);

                if (i < currentStep) {
                    btn.classList.remove("btn-light");
                    btn.classList.add("btn-primary"); // completed
                }
                else if (i === currentStep) {
                    btn.classList.remove("btn-light");
                    btn.classList.add("btn-primary"); // current
                }
                else {
                    btn.classList.remove("btn-primary");
                    btn.classList.add("btn-light"); // upcoming
                }
            }

            // Update progress line
            let percent = ((currentStep - 1) / (totalSteps - 1)) * 100;
            document.getElementById("progressLine").style.width = percent + "%";
        }



        // Next
        document.querySelectorAll('.next-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                 if ($("#jobForm").valid()) {
                if (currentStep < totalSteps) {
                    currentStep++;
                    updateSteps();
                }
                }
            });
        });

        // Previous
        document.querySelectorAll('.prev-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                if (currentStep > 1) {
                    currentStep--;
                    updateSteps();
                }
            });
        });

        updateSteps();
    </script>
}
