@model DashboardViewModel
@{
	ViewData["Title"] = "Job Application";
	Layout = "~/Views/Shared/_JobLayout.cshtml";

}

<div class="row">
	<div class="col-12">
		<div class="card">
			<div class="card-body">
				<h5 class="mb-3">Job Application</h5>
				<div class="progress progress-step-arrow progress-info mb-4" id="stepProgress">
					<a class="progress-bar active" style="width: 100%">Create Profile</a>
					<a class="progress-bar" style="width: 100%">Welcome</a>
					<a class="progress-bar" style="width: 100%">About Us</a>
					<a class="progress-bar" style="width: 100%">Bank Details</a>
				</div>
				<form class="form-horizontal form-material mb-0 " id="jobForm">

					<!-- STEP 1 -->
					<div class="step" id="step1">
						<h5>Create Profile</h5>
						<hr />
						<div class="row g-3">
							<div class="col-md-4">
								<label>First Name</label>
								<input asp-for="MedicareJobModel.FirstName" type="text" class="form-control req-border" />
								<span asp-validation-for="MedicareJobModel.FirstName" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>Last Name</label>
								<input asp-for="MedicareJobModel.LastName" type="text" class="form-control req-border" />
								<span asp-validation-for="MedicareJobModel.LastName" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>Address 1</label>
								<input asp-for="MedicareJobModel.Address1" type="text" class="form-control req-border" />
								<span asp-validation-for="MedicareJobModel.Address1" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>Address 2</label>
								<input asp-for="MedicareJobModel.Address2" type="text" class="form-control" />
								<span asp-validation-for="MedicareJobModel.Address2" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>City</label>
								<input asp-for="MedicareJobModel.City" type="text" class="form-control req-border" />
								<span asp-validation-for="MedicareJobModel.City" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>State</label>
								<select class="form-select req-border" asp-for="MedicareJobModel.StateId" asp-items="Model.StateList"></select>
								<span asp-validation-for="MedicareJobModel.StateId" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>NPN</label>
								<input asp-for="MedicareJobModel.Npn" type="text" class="form-control req-border" />
								<span asp-validation-for="MedicareJobModel.Npn" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>Date of Birth</label>
								<input asp-for="MedicareJobModel.Dob" class="form-control date-picker req-border" />
								<span asp-validation-for="MedicareJobModel.Dob" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>Email</label>
								<input asp-for="MedicareJobModel.Email" type="email" class="form-control email-inputmask req-border" />
								<span asp-validation-for="MedicareJobModel.Email" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>Phone</label>
								<input asp-for="MedicareJobModel.PhoneNo" type="text" class="form-control phone-inputmask req-border" />
								<span asp-validation-for="MedicareJobModel.PhoneNo" class="text-danger "></span>
							</div>
						</div>

						<div class="text-end mt-3">
							<button type="button" class="btn btn-primary next-btn">Next</button>
						</div>
					</div>

					<!-- STEP 2 -->
					<div class="step d-none" id="step2">
						<h5>Welcome</h5>
						<hr />

						<div class="row g-3">
							<div class="col-md-12">
								<label>About You</label>
								<textarea asp-for="MedicareJobModel.AboutAgent" class="form-control req-border"></textarea>
								<span asp-validation-for="MedicareJobModel.AboutAgent" class="text-danger"></span>
							</div>

							<div class="col-md-4">
								<label>State License</label>
								<select asp-for="MedicareJobModel.StateLicenceList" class="form-select req-border" id="multipleSelect" multiple data-placeholder="Select" asp-items="Model.StateList">
								</select>
								<span asp-validation-for="MedicareJobModel.StateLicenceList" class="text-danger"></span>

							</div>
							<div class="col-md-4">
								<label>State Licence No.</label>
								<input asp-for="MedicareJobModel.StateLicenceNo" type="text" class="form-control req-border" />
								<span asp-validation-for="MedicareJobModel.StateLicenceNo" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>State License Doc</label>
								<input type="file" id="JobDoc_2" class="form-control req-border"
									   onchange="CFP.Dashboard.SaveDocument(2)" />
							</div>
							<div class="col-md-4">
								<label>Years of Experience</label>
								<input asp-for="MedicareJobModel.Yoe" type="number" class="form-control req-border" min="0" />
								<span asp-validation-for="MedicareJobModel.Yoe" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>Carrier</label>
								<select asp-for="MedicareJobModel.Carrier" class="form-select req-border" asp-items="Model.CareerList">
								</select>
								<span asp-validation-for="MedicareJobModel.Carrier" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>Carrier</label>
								<select asp-for="MedicareJobModel.Ahip" class="form-select req-border">
									<option value="true">Yes</option>
									<option value="false">No</option>
								</select>
								<span asp-validation-for="MedicareJobModel.Ahip" class="text-danger"></span>
							</div>
						</div>

						<div class="d-flex justify-content-between mt-3">
							<button type="button" class="btn btn-secondary prev-btn">Back</button>
							<button type="button" class="btn btn-primary next-btn">Next</button>
						</div>
					</div>

					<!-- STEP 3 -->
					<div class="step d-none" id="step3">
						<h5>About Us</h5>
						<hr />
						<div class="mb-3">
							<label>About Yourself</label>
							<textarea asp-for="MedicareJobModel.AboutUs" class="form-control req-border" rows="4"></textarea>
							<span asp-validation-for="MedicareJobModel.AboutUs" class="text-danger"></span>
						</div>

						<div class="d-flex justify-content-between mt-3">
							<button type="button" class="btn btn-secondary prev-btn">Back</button>
							<button type="button" class="btn btn-primary next-btn">Next</button>
						</div>
					</div>

					<!-- STEP 4 -->
					<div class="step d-none" id="step4">
						<h5>Bank Details</h5>
						<hr />

						<div class="row g-3">

							<div class="col-md-4">
								<label>Account Number</label>
								<input asp-for="MedicareJobModel.BankAccNo" type="text" class="form-control req-border" />
								<span asp-validation-for="MedicareJobModel.BankAccNo" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>IFSC Code</label>
								<input asp-for="MedicareJobModel.BankIfsc" type="text" class="form-control req-border" />
								<span asp-validation-for="MedicareJobModel.BankIfsc" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>Bank Name</label>
								<input asp-for="MedicareJobModel.BankName" type="text" class="form-control req-border" />
								<span asp-validation-for="MedicareJobModel.BankName" class="text-danger"></span>
							</div>
							<div class="col-md-4">
								<label>Profile</label>
								<input type="file" id="JobDoc_1" class="form-control req-border"
									   onchange="CFP.Dashboard.SaveDocument(1)" />
							</div>



							<div class="col-md-4">
								<label>Assignment Commission Doc</label>
								<input type="file" id="JobDoc_3" class="form-control req-border"
									   onchange="CFP.Dashboard.SaveDocument(3)" />
							</div>

							<div class="col-md-4">
								<label>ENO Certificate Doc</label>
								<input type="file" id="JobDoc_4" class="form-control req-border"
									   onchange="CFP.Dashboard.SaveDocument(4)" />
							</div>

						</div>

						<div class="d-flex justify-content-between mt-3">
							<button type="button" class="btn btn-secondary prev-btn">Back</button>
							<button type="button" class="btn btn-success" onclick="CFP.Dashboard.SaveJobForm()">Submit Application</button>
						</div>
					</div>

				</form>


			</div>
		</div>
	</div>
</div>
@section Scripts {
	<script>

		 $(document).ready(function () {
			  $.validator.unobtrusive.parse($("#jobForm"));
			   CFP.Common.InitDatePicker();
			   CFP.Common.InitMask();
				  $('#multipleSelect').select2();
		 });


		let currentStep = 1;
		const totalSteps = 4;

				function updateSteps() {
			// Hide all steps
			document.querySelectorAll('.step').forEach(x => x.classList.add('d-none'));

			// Show current step
			document.getElementById(`step${currentStep}`).classList.remove('d-none');

			// Update progress bar
			const bars = document.querySelectorAll("#stepProgress .progress-bar");

			bars.forEach((b, i) => {
				
				b.classList.remove("active", "current", "bg-light", "text-body");

				if (i < currentStep - 1) {
					// completed
					b.classList.add("active");
				}
				else if (i === currentStep - 1) {
					// current step
					b.classList.add("active", "current");
				}
				else {
					// upcoming
					b.classList.add("bg-light", "text-body");
				}
				 
			});
		}


		// Next
		document.querySelectorAll('.next-btn').forEach(btn => {
			btn.addEventListener('click', function () {
				 if ($("#jobForm").valid()) {
				if (currentStep < totalSteps) {
					currentStep++;
					updateSteps();
				}
				}
			});
		});

		// Previous
		document.querySelectorAll('.prev-btn').forEach(btn => {
			btn.addEventListener('click', function () {
				if (currentStep > 1) {
					currentStep--;
					updateSteps();
				}
			});
		});

		updateSteps();
	</script>
}