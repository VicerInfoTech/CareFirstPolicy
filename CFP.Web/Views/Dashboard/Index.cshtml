@using CFP.Common.Utility
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewBag.ParentPageName = "<a href='/Dashboard/Index'><i class='ri-home-2-line'></i> Home</a>";
    ViewBag.PageName = "<i class='ri-dashboard-line'></i>  Dashboard";
}

<style>
    .chart-hidden {
        visibility: hidden !important;
        height: 0 !important;
    }

    .progress {
        width: 300px !important;
    }

    .OverallTotel {
        font-weight: 800 !important;
        border-top: 3px double #a4a4a4 !important;
    }

    .total {
        font-weight: 600 !important;
    }

    .form-icon-container {
        position: relative;
    }

    .form-icon {
        position: absolute;
        top: 50%;
        left: 10px; /* icon goes inside left side of input */
        transform: translateY(-50%);
        pointer-events: none; /* so you can click inside input */
        font-size: 16px;
        color: #6c757d;
    }

    .form-icon-input {
        padding-left: 2rem !important; /* space for the icon */
    }


</style>


@if (Model.UserAccess == (int)Enumeration.UserAccess.FullAccess)
{

    @if (Model.RoleId == (int)Enumeration.Role.Agent || Model.RoleId == (int)Enumeration.Role.AgentLead)
    {
        <link rel="stylesheet" href="~/assets/css/leaderboard.css" asp-append-version="true" />
        <div class="row">
            <div class="row">
                <div class="col-xl-6">
                    <div class="card overflow-hidden">
                        <div class="card-body bg-marketplace d-flex">
                            <div class="flex-grow-1">
                                <h4 class="fs-18 lh-base mb-0">Connecting Care with Confidence. <br> Lets achive your own <span class="text-success">Goal.</span> </h4>
                                <p class="mb-0 mt-2 pt-1 text-muted">Because Every Patient Deserves a Caring Voice.</p>
                                <div class="d-flex gap-3 mt-4">
                                    <a href="https://www.healthsherpa.com/sessions/new" target="_blank" class="btn btn-primary">Goto HealthSherpa</a>
                                    <a href="@Url.Content("Deal")" class="btn btn-success">Create Your Deal</a>
                                </div>
                            </div>
                            <img src="assets/images/bg-d.png" alt="" class="img-fluid">
                        </div>
                    </div>
                </div><!--end col-->
                <div class="col-xl-3 col-md-6">
                    <a href="@Url.Content("Deal")">
                        <div class="card card-height-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm flex-shrink-0">
                                        <span class="avatar-title bg-info-subtle rounded fs-3">
                                            <i class="ri-shake-hands-line text-info"></i>
                                        </span>
                                    </div>
                                    <div class="flex-grow-1 ps-3">
                                        <h5 class="text-muted text-uppercase fs-13 mb-0">Total Deals</h5>
                                    </div>
                                </div>
                                <div class="mt-4 pt-1">
                                    <h4 class="fs-22 fw-semibold ff-secondary mb-0"><span class="counter-value" data-target="@Model.DealCount">@Model.DealCount</span> </h4>
                                    <p class="mt-4 mb-0 text-muted"><span class="badge bg-success-subtle text-success mb-0"> Overall Deals </span></p>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>


            <div class="row">
                <div class="col-xl-6">
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="row g-0">
                                <div class="row g-0">
                                    <div class="col-xxl-12">
                                        <div class="">
                                            <input asp-for="EndDate" hidden id="startDate" />
                                            <div class="card-header border-0 align-items-center d-flex">
                                                <h4 class="card-title mb-0 flex-grow-1">🏆 Live Leaderboard</h4>
                                            </div><!-- end card header -->
                                            <div class="row g-0">
                                                <div class="col-12 col-sm-12">
                                                    <div class="p-3 border border-dashed border-start-0 border-end-0 border-bottom-0" style="height: 500px;overflow: auto;">
                                                        <div class="list" id="leaderboard"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6 ">
                    <div class="card card-animate">

                        <!-- HEADER WITH FILTER BUTTONS -->
                        <div class="card-header border-0 align-items-center d-flex">
                            <h4 class="card-title mb-0 flex-grow-1">Deals – Recent 10 Days</h4>
                            <input asp-for="AgentId" hidden id="AgentId" class="hidAgent" />
                        </div>

                        <!-- METRICS BAR (LIKE THE THEME) -->
                        <div class="card-header p-0 border-0 bg-light-subtle">
                            <div class="row g-0 text-center">
                                <div class="col-6 col-sm-4">
                                    <div class="p-3 border border-dashed border-start-0">
                                        <h5 class="mb-1" id="metricDeals">0</h5>
                                        <p class="text-muted mb-0">Total Forms</p>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-3 border border-dashed border-start-0">
                                        <h5 class="mb-1" id="metricApplicants">0</h5>
                                        <p class="text-muted mb-0">Total Deals</p>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <div class="p-3 border border-dashed border-start-0 border-end-0">
                                        <h5 class="mb-1 text-success" id="metricAvgDeals">0</h5>
                                        <p class="text-muted mb-0">Avg Deals/Day</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- CHART -->
                        <div class="card-body p-0 pb-2">
                            <div id="dealLineChart" data-colors='["--vz-secondary", "--vz-warning", "--vz-success"]' class="apex-charts" dir="ltr"></div>
                            <div id="dealNoData" class="text-center text-muted mt-3" style="display:none; font-size:14px;">
                                No deal data available.
                            </div>
                        </div>
                    </div>
                </div>
                <!--end col-->
            </div>
        </div>
    }

    @if (Model.RoleId == (int)Enumeration.Role.Super_Admin)
    {
        <div class="row g-4 mb-4">
            <div class="col-xl-9">
                <div class="card card-animate">

                    <!-- HEADER WITH FILTER BUTTONS -->
                    <div class="card-header border-0 align-items-center d-flex">
                        <h4 class="card-title mb-0 flex-grow-1">Deals – Recent 10 Days</h4>

                        <div class="d-flex gap-1">
                            <select class="form-select form-select-sm" id="AgentId"
                                    style="width:150px" onchange="CFP.Dashboard.BindDealChart()">
                                <option value="-1">All Agents</option>
                                @foreach (var a in Model.AgentList)
                                {
                                    <option value="@a.Value">@a.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- METRICS BAR (LIKE THE THEME) -->
                    <div class="card-header p-0 border-0 bg-light-subtle">
                        <div class="row g-0 text-center">
                            <div class="col-6 col-sm-3">
                                <div class="p-3 border border-dashed border-start-0">
                                    <h5 class="mb-1" id="metricDeals">0</h5>
                                    <p class="text-muted mb-0">Total Forms</p>
                                </div>
                            </div>

                            <div class="col-6 col-sm-3">
                                <div class="p-3 border border-dashed border-start-0">
                                    <h5 class="mb-1" id="metricApplicants">0</h5>
                                    <p class="text-muted mb-0">Total Deals</p>
                                </div>
                            </div>

                            <div class="col-6 col-sm-3">
                                <div class="p-3 border border-dashed border-start-0">
                                    <h5 class="mb-1" id="metricAgents">0</h5>
                                    <p class="text-muted mb-0">Active Agents</p>
                                </div>
                            </div>

                            <div class="col-6 col-sm-3">
                                <div class="p-3 border border-dashed border-start-0 border-end-0">
                                    <h5 class="mb-1 text-success" id="metricAvgDeals">0</h5>
                                    <p class="text-muted mb-0">Avg Deals/Day</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CHART -->
                    <div class="card-body p-0 pb-2">
                        <div id="dealLineChart" data-colors='["--vz-secondary", "--vz-warning", "--vz-success"]' class="apex-charts" dir="ltr"></div>
                        <div id="dealNoData" class="text-center text-muted mt-3" style="display:none; font-size:14px;">
                            No deal data available.
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-xxl-3">
                <div class="card card-animate ">
                    <div class="card-header border-0 align-items-center d-flex">
                        <h4 class="card-title mb-0 flex-grow-1">Deals Portfolio</h4>
                        @Html.Hidden("StartDate", Model.StartDate.ToString("MM/dd/yyyy"), new { id = "startDate" })
                        @Html.Hidden("EndDate", Model.EndDate.ToString("MM/dd/yyyy"), new { id = "endDate" })

                        <div class="form-icon-container flex-fill" style="max-width:14rem;">
                            <input type="text"
                                   id="dateRange"
                                   class="form-control form-control-sm date-picker form-icon-input"
                                   placeholder="Select date range"
                                   data-provider="flatpickr"
                                   data-mode="range"
                                   data-date-format="m/d/Y"
                                   autocomplete="off" />
                            <span class="ri-calendar-line text-900 fs--1 form-icon"></span>
                        </div>
                    </div><!-- end cardheader -->

                    <div class="card-body">
                        <div id="portfolio_donut_charts" class="apex-charts" style="min-height: 227px;">
                            <div id="portfolioDonut"></div>
                        </div>

                        <!-- Top 5 agents -->
                        <ul id="portfolioTop5" class="list-group list-group-flush border-dashed mb-0 mt-3 pt-2">
                            <!-- Filled by JS -->
                        </ul>
                    </div><!-- end card body -->
                </div><!-- end card -->
            </div>

        </div>
        <div class="row g-4 mb-4">

            <div class="col-xl-12 mt-1">
                @Html.Hidden("DealStartDate", Model.StartDate.ToString("MM/dd/yyyy"), new { id = "dealStartDate" })
                @Html.Hidden("DealEndDate", Model.EndDate.ToString("MM/dd/yyyy"), new { id = "dealEndDate" })
                <div class="card card-animate">
                    <div class="card-header d-flex align-items-center">
                        <h4 class="card-title flex-grow-1 mb-0">Deals Summary By Date </h4>
                        <div class="form-icon-container flex-fill" style="max-width:14rem;margin-right:10px;" >
                            <input type="text"
                                   id="dealDateRange"
                                   class="form-control form-control-sm date-picker form-icon-input"
                                   placeholder="Select date range"
                                   data-provider="flatpickr"
                                   data-mode="range"
                                   data-date-format="m/d/Y"
                                   autocomplete="off" />
                            <span class="ri-calendar-line text-900 fs--1 form-icon"></span>
                        </div>
                        <button type="button" class="btn btn-sm btn-soft-success" onclick="CFP.Dashboard.DownloadDealSummaryData()">
                            <i class="ri-download-line"></i> Excel
                        </button>
                    </div><!-- end cardheader -->
                    <div class="card-body">
                       <div id="showDealSummary"></div>

                    </div><!-- end card body -->
                </div><!-- end card -->

            </div>
        </div>
    }

    @section Scripts {
        <script src="/assets/libs/apexcharts/apexcharts.min.js"></script>
        <script src="assets/js/pages/dashboard-crypto.init.js"></script>
        <script src="/assets/libs/swiper/swiper-bundle.min.js"></script>
        <script src="/assets/js/pages/dashboard-crypto.init.js"></script>
        <script src="/assets/js/pages/dashboard-projects.init.js"></script>
        <script src="assets/js/pages/dashboard-crm.init.js"></script>
        <script src="assets/js/pages/dashboard-projects.init.js"></script>
        @* <script src="~/assets/libs/chart.js/chart.js"></script> *@
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="~/lib/js/custom/CFP.Dashboard.js" asp-append-version="true"></script>
        <script src="~/lib/js/custom/CFP.Leaderboard.js" asp-append-version="true"></script>
        <script>
            $(document).ready(function () {

                // Flatpickr range picker
             var startDate = $("#startDate").val();
            var endDate = $("#endDate").val();

            $("#dateRange").flatpickr({
                mode: "range",
                dateFormat: "m/d/Y", // UI format
                defaultDate: [startDate, endDate],
                onChange: function (selectedDates, dateStr, instance) {
                    if (selectedDates.length === 2) {
                        $("#startDate").val(instance.formatDate(selectedDates[0], "m/d/Y"));
                        $("#endDate").val(instance.formatDate(selectedDates[1], "m/d/Y"));
                        CFP.Dashboard.LoadPortfolioChart();
                    }
                }
            });


            var dealStartDate = $("#dealStartDate").val();
            var dealEndDate = $("#dealEndDate").val();

            $("#dealDateRange").flatpickr({
                mode: "range",
                dateFormat: "m/d/Y", // UI format
                defaultDate: [dealStartDate, dealEndDate],
                onChange: function (selectedDates, dateStr, instance) {
                    if (selectedDates.length === 2) {
                        $("#dealStartDate").val(instance.formatDate(selectedDates[0], "m/d/Y"));
                        $("#dealEndDate").val(instance.formatDate(selectedDates[1], "m/d/Y"));
                        CFP.Dashboard.DealSummary();
                    }
                }
            });
            CFP.Dashboard.DealSummary();
                Chart.defaults.font.family = "'Montserrat', sans-serif";
              //  CFP.Common.MenuLink("/Order/Dashboard");
                  CFP.Dashboard.BindDealChart();
                  CFP.Dashboard.LoadPortfolioChart();
                CFP.Leaderboard.refreshScores();
                 
                CFP.Dashboard.Init('@Model.RoleId');
                $("#txtSearch").on("keyup", function () {
                    CFP.Dashboard.Search();
                });
            });
        </script>
    }

}

