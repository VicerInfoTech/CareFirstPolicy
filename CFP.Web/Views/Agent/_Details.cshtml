@using CFP.Common.Business_Entities

@model AgentViewModel


<div class="modal-header">
    <h4 class="modal-title fw-600" id="myModalLabel">
        <i class='ri-user-3-line font-20'></i> @(Model.AgentMasterModel.AgentMasterId > 0 ? "Edit Agent" : "Add New Agent")
    </h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="close-modal"></button>
</div>

<div class="card" style="margin-bottom:0px !important;">
    <div class="card-body" style="padding-left:1rem;padding-right:1rem;">
        <form class="validation-wizard form-horizontal form-material needs-validation" id="AgentMasterForm">

            <input asp-for="AgentMasterModel.EncId" type="hidden" />
            <input asp-for="AgentMasterModel.UserMasterId" type="hidden" />
            <input asp-for="AgentMasterModel.CreatedBy" type="hidden" />
            <input asp-for="AgentMasterModel.CreatedOn" type="hidden" />
            <input asp-for="AgentMasterModel.IsActive" type="hidden" />

            <div class="row">

                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.FirstName"></label>
                    <input asp-for="AgentMasterModel.FirstName" class="form-control req-border" placeholder="First Name" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.FirstName"></span>
                </div>

                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.LastName"></label>
                    <input asp-for="AgentMasterModel.LastName" class="form-control req-border" placeholder="Last Name" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.LastName"></span>
                </div>
                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.Email"></label>
                    <input asp-for="AgentMasterModel.Email" class="form-control req-border" placeholder="Login Username" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.Email"></span>
                </div>
                <div class="col-md-6 mt-2">
                    <label asp-for="AgentMasterModel.Dob"></label>
                    <input asp-for="AgentMasterModel.Dob" placeholder="Select dob" class="form-control  date-picker" />
                </div>
                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.Ssn"></label>
                    <input asp-for="AgentMasterModel.Ssn" class="form-control " placeholder="SSN" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.Ssn"></span>
                </div>
                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.ContactNumber"></label>
                    <input asp-for="AgentMasterModel.ContactNumber" class="form-control " placeholder="Contact Number" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.ContactNumber"></span>
                </div>
                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.Designation"></label>
                    <input asp-for="AgentMasterModel.Designation" class="form-control " placeholder="Designation" autocomplete="off" />
                </div>
                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.Npn"></label>
                    <input asp-for="AgentMasterModel.Npn" class="form-control " placeholder="NPN" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.Npn"></span>
                </div>
                <div class="col-2 mt-2">
                    <label asp-for="AgentMasterModel.ChaseExt"></label>
                    <input asp-for="AgentMasterModel.ChaseExt" class="form-control " placeholder="Chase Ext." autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.ChaseExt"></span>
                </div>
                <div class="col-5 mt-2">
                    <label asp-for="AgentMasterModel.ChaseDataUsername"></label>
                    <input asp-for="AgentMasterModel.ChaseDataUsername" class="form-control " placeholder="Chase Data Login" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.ChaseDataUsername"></span>
                </div>
                <div class="col-5 mt-2">
                    <label asp-for="AgentMasterModel.ChaseDataPassword"></label>
                    <input asp-for="AgentMasterModel.ChaseDataPassword" class="form-control " placeholder="Chase Data Password" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.ChaseDataPassword"></span>
                </div>

                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.HealthSherpaUsername"></label>
                    <input asp-for="AgentMasterModel.HealthSherpaUsername" class="form-control " placeholder="Healthsherpa Login" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.HealthSherpaUsername"></span>
                </div>
                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.HealthSherpaPassword"></label>
                    <input asp-for="AgentMasterModel.HealthSherpaPassword" class="form-control " placeholder="HealthSherpa Password" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.HealthSherpaPassword"></span>
                </div>

                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.MyMfgUsername"></label>
                    <input asp-for="AgentMasterModel.MyMfgUsername" class="form-control " placeholder="MyMFG Username" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.MyMfgUsername"></span>
                </div>
                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.MyMfgPassword"></label>
                    <input asp-for="AgentMasterModel.MyMfgPassword" class="form-control " placeholder="MyMFG Password" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.MyMfgPassword"></span>
                </div>
                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.FfmUsername"></label>
                    <input asp-for="AgentMasterModel.FfmUsername" class="form-control " placeholder="FFM Username " autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.FfmUsername"></span>
                </div>
                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.Forwarding"></label>
                    <input asp-for="AgentMasterModel.Forwarding" class="form-control " placeholder="Forwarding" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.Forwarding"></span>
                </div>
                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.PayStructure"></label>
                    <input asp-for="AgentMasterModel.PayStructure" class="form-control " placeholder="Pay Structure" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="AgentMasterModel.PayStructure"></span>
                </div>
                @if (string.IsNullOrEmpty(Model.AgentMasterModel.EncId))
                {
                    <div class="col-md-6 mt-2">
                        <label asp-for="AgentMasterModel.RoleId"></label>
                        <select asp-for="AgentMasterModel.RoleId" class="form-select req-border">
                            <option value="3">Agent</option>
                            <option value="2">Agent Lead</option>
                        </select>
                    </div>
                }
                <div class="col-6 mt-2">
                    <label asp-for="AgentMasterModel.UserAccess"></label>
                    <select asp-for="AgentMasterModel.UserAccess" class="form-select req-border">
                        <option value="2">Training</option>
                        <option value="1">Full Access</option>
                    </select>
                    <span class="text-danger" asp-validation-for="AgentMasterModel.UserAccess"></span>
                </div>
                @if (string.IsNullOrEmpty(Model.AgentMasterModel.EncId))
                {
                    <div class="col-6 mt-2">
                        <label asp-for="AgentMasterModel.AppsList">Apps</label>
                        <select asp-for="AgentMasterModel.AppsList" class="form-select req-border" id="multipleSelect" multiple data-placeholder="Select">
                            @foreach (var item in Model.AppMasterModels)
                            {
                                <option value="@item.AppId">@item.AppName</option>
                            }
                        </select>
                        <span asp-validation-for="AgentMasterModel.AppsList" class="text-danger"></span>
                    </div>
                }
            </div>

        </form>
    </div>
</div>

<div class="modal-footer mt-3" style="margin-right: 1%;margin-top: 2%;">
    <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal"><i class="ri-close-line"></i> Cancel</button>
    <button type="button" class="btn btn-success" onclick="CFP.Agent.Save()"><i class="ri-save-line"></i> Submit</button>
</div>
