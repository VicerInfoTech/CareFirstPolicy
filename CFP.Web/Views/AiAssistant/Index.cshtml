@model AiAssistantViewModel
@{
    ViewData["Title"] = "Ai Assistant";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.ParentPageName = "<a href='/Dashboard/Index'><i class='ri-home-2-line'></i> Home</a>";
    ViewBag.PageName = "<i class='ri-shake-hands-line'></i> Ai Assistant";
}

@* anti-forgery token for AJAX posts *@
@Html.AntiForgeryToken()

<style>
    /* container that holds chat area + input group */
    .ai-chat-wrapper {
        width: 100%;
        margin: 0 auto;
    }

    /* visible chat area */
    .chat-container {
        height: calc(100vh - 260px); /* visible area height */
        border: 1px solid #ccc;
        border-radius: 10px;
        padding: 15px;
        background: #f7f7f7;
        display: flex;
        flex-direction: column;
    }

    /* scrollable box for messages */
    #chatBox {
        flex: 1;
        overflow-y: auto;
        padding-right: 8px;
    }

    .message {
        max-width: 72%;
        padding: 10px 14px;
        margin: 8px 0;
        border-radius: 15px;
        clear: both;
        display: block;
        word-wrap: break-word;
        font-size: 14px;
    }

        /* user message - right */
        .message.user {
            background: #007bff;
            color: #fff;
            float: right;
            border-bottom-right-radius: 4px;
        }

        /* ai message - left */
        .message.ai {
            background: #e9eaee;
            color: #111;
            float: left;
            border-bottom-left-radius: 4px;
        }

        /* typing indicator bubble */
        .message.typing {
            background: #f0f0f0;
            color: #555;
            float: left;
            font-style: italic;
        }

    /* input area below chat */
    .chat-input-row {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    #userInput {
        flex: 1;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    #sendBtn {
        padding: 10px 18px;
        border-radius: 8px;
        border: none;
        background: #007bff;
        color: white;
        cursor: pointer;
    }

    /* ensure floats don't break layout when new content added */
    .clearfix::after {
        content: "";
        clear: both;
        display: table;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="ai-chat-wrapper">
                    <div class="chat-container">
                        <div id="chatBox" class="clearfix"></div>

                        <div class="chat-input-row">
                            <input type="text" id="userInput" class="form-control" placeholder="Type your message..." />
                            <button id="sendBtn" class="btn" onclick="sendMessage()">Send</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Get antiforgery token value rendered by @Html.AntiForgeryToken()
        function getAntiforgeryToken() {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        function appendMessage(text, cssClass) {
            const chatBox = document.getElementById('chatBox');

            const msg = document.createElement('div');
            msg.classList.add('message', cssClass);
            msg.innerText = text;

            chatBox.appendChild(msg);
            // Auto-scroll to bottom
            chatBox.scrollTop = chatBox.scrollHeight;
            return msg;
        }

        function sendMessage() {
            const input = document.getElementById('userInput');
            const text = input.value.trim();
            if (!text) return;

            // show user on RIGHT
            appendMessage(text, 'user');
            input.value = '';

            // show typing indicator (left)
            const typingNode = appendMessage('AI is typing...', 'typing');

            // prepare payload to match AiAssistantViewModel { Message }
            const payload = { Message: text };

            // build correct url using route - it's safer to use Url.Action but here we use relative path
            const url = '@Url.Action("GetChatResponse", "AiAssistant")';

            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiforgeryToken()
                },
                body: JSON.stringify(payload)
            })
            .then(async res => {
                if (!res.ok) {
                    // try read body for details
                    const text = await res.text();
                    throw new Error('Server returned ' + res.status + ' — ' + text);
                }
                return res.json();
            })
            .then(data => {
                typingNode.remove();
                // If your controller returns { response } use data.response, otherwise adapt accordingly
                const aiText = data?.response ?? data?.Response ?? 'No response';
                appendMessage(aiText, 'ai');
            })
            .catch(err => {
                typingNode.remove();
                appendMessage('Error: ' + (err.message || 'Unknown error'), 'ai');
                console.error('Chat fetch error:', err);
            });
        }

        // Send on Enter key
        document.getElementById('userInput').addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        // optional: focus input on load
        document.getElementById('userInput').focus();
    </script>
}
