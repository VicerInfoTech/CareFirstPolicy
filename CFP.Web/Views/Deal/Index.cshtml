@model DashboardViewModel
@{
    ViewData["Title"] = "Deal";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //ViewBag.ParentPageName = "Deal";
    ViewBag.ParentPageName = "<a href='/Dashboard/Index'><i class='ri-home-2-line'></i> Home</a>";
    ViewBag.PageName = "<i class='ri-shake-hands-line'></i>  Deals";
}
<link href="~/lib/css/gorev/bootstrap-datepicker.min.css" rel="stylesheet" asp-append-version="true" />
<style>
    .form-icon-container {
        position: relative;
    }

    .form-icon {
        position: absolute;
        top: 50%;
        left: 10px; /* icon goes inside left side of input */
        transform: translateY(-50%);
        pointer-events: none; /* so you can click inside input */
        font-size: 16px;
        color: #6c757d;
    }

    .form-icon-input {
        padding-left: 2rem !important; /* space for the icon */
    }

</style>
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
                        <div class="input-group mt-1" id="searchId">
                            <input class="form-control" id="txtSearch" autocomplete="off" placeholder="Search..." />
                            <div class="input-group-append pointermouse" onclick="CFP.Deal.Search()">
                                <span class="input-group-text"><i class="ri-search-line"></i></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
                        @*   <select class="form-control mt-1" id="ddStatus" onchange="AlphaLabTOD.User.Search();">
                                <option value="0"> All Status</option>
                                <option value="@((int)Enumeration.ActiveInActiveStatus.Active)"> Active</option>
                                <option value="@((int)Enumeration.ActiveInActiveStatus.In_Active)"> In-Active</option>
                            </select> *@
                        @Html.Hidden("StartDate", Model.StartDate.ToString("MM/dd/yyyy"), new { id = "startDate" })
                        @Html.Hidden("EndDate", Model.EndDate.ToString("MM/dd/yyyy"), new { id = "endDate" })

                        <div class="form-icon-container flex-fill" style="max-width:14rem;margin-top:4px;" >
                            <input type="text"
                                   id="dateRange"
                                   class="form-control  date-picker form-icon-input"
                                   placeholder="Select date range"
                                   data-provider="flatpickr"
                                   data-mode="range"
                                   data-date-format="m/d/Y"
                                   autocomplete="off" />
                            <span class="ri-calendar-line text-900 fs--1 form-icon"></span>
                        </div>
                    </div>
                    <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 text-right mt-1">
                        <button type="button" class="btn btn-success" onclick="CFP.Deal.DownloadDealData()">
                            <i class="ri-download-line"></i> Excel
                        </button>
                        <button type="button" class="btn btn-primary" onclick="CFP.Deal.Add()">
                            <i class="ri-add-line"></i> Create New Deal
                        </button>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 table-responsive">
                        <table class="table table-hover table-bordered display responsive nowrap" width="100%" id="userTableId">
                            <thead>
                                <tr>
                                    <th><b>Deal #</b></th>
                                    <th><b>Full Name</b></th>
                                    <th><b># Applicants</b></th>
                                    <th><b>Career</b></th>
                                    <th><b>Closed Date</b></th>
                                    <th><b>Agent</b></th>
                                    <th><b>Created By</b></th>
                                    <th><b>Action</b></th>
                                </tr>
                            </thead>
                            <tbody id="userTableBody"></tbody>
                            <tfoot id="tablefoot" class="highlight" style="background-color:darkgray;overflow-y:scroll">
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/js/gorev/bootstrap-datepicker.min.js" asp-append-version="true"></script>
    <script src="~/lib/js/custom/CFP.Deal.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            CFP.Deal.Init();
            $("#txtSearch").on("keyup", function () {
                CFP.Deal.Search();
            });

             var startDate = $("#startDate").val();
            var endDate = $("#endDate").val();

            $("#dateRange").flatpickr({
                mode: "range",
                dateFormat: "m/d/Y", // UI format
                defaultDate: [startDate, endDate],
                onChange: function (selectedDates, dateStr, instance) {
                    if (selectedDates.length === 2) {
                        $("#startDate").val(instance.formatDate(selectedDates[0], "m/d/Y"));
                        $("#endDate").val(instance.formatDate(selectedDates[1], "m/d/Y"));
                        CFP.Deal.Search();
                    }
                }
            });
        });
    </script>
}
